NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
BUSINESS_NAME=NovaCart
BUSINESS_COUNTRY=Sri-Lanka
BUSINESS_ADDRESS=CHANGE-ME
SUPPORT_EMAIL=CHANGE-ME@example.com
PRIVACY_EMAIL=CHANGE-ME@example.com
SUPPORT_HOURS=Mon-Fri 09:00-18:00
DEFAULT_LANGUAGE=en
CURRENCY=USD
DATABASE_URL=postgresql://novacart:novacart@localhost:55433/novacart
POSTGRES_PASSWORD=novacart
SESSION_DAYS=30
SESSION_IDLE_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE-THIS-TO-A-LONG-RANDOM-PASSWORD
PASSWORD_MIN=8
ADMIN_PASSWORD_MIN=12
ADMIN_MFA_REQUIRED=true
ADMIN_MFA_METHOD=totp
ADMIN_MFA_SECRET=
SYNC_ADMIN_FROM_ENV=false
ENFORCE_ORIGIN_CHECK=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Email: smtp (default), or brevo HTTPS API for hosts that block SMTP ports.
MAIL_PROVIDER=smtp
# Brevo requires a verified sender and an approved transactional email account.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NovaCart <no-reply@example.com>"
TAX_RATE=0
TAX_RATES_JSON={}
SHIPPING_ZONES_JSON={}
STANDARD_SHIPPING_RATE=5.99
FREE_SHIPPING_THRESHOLD=75
EXPRESS_SHIPPING_RATE=12.99
RETURNS_DAYS=30
ORDER_RETURN_WINDOW_DAYS=30
REQUIRE_EMAIL_VERIFICATION=false
ENABLE_OAUTH_GOOGLE=false
ENABLE_OAUTH_APPLE=false
DB_POOL_MAX=15
DB_WAIT_TRIES=60
DB_WAIT_DELAY_MS=2000

TRUST_PROXY=0
REMEMBER_DAYS=1
METRICS_TOKEN=CHANGE-THIS-TO-A-LONG-RANDOM-METRICS-TOKEN

PLATFORM_COMMISSION_BPS=1000
LOYALTY_POINTS_PER_CURRENCY=1
FRAUD_REVIEW_SCORE=70
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=

# Optional provider integrations: disabled until configured and approved.
OAUTH_APPLE_PRIVATE_KEY=
ENABLE_VISUAL_SEARCH=false
GOOGLE_VISION_API_KEY=
VISUAL_SEARCH_DAILY_LIMIT=200
ENABLE_AMAZON_SYNC=false
ENABLE_AMAZON_FORWARDING=false
AMAZON_SP_API_REGION=na
AMAZON_MARKETPLACE_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
ENABLE_ALIEXPRESS_SYNC=false
ENABLE_ALIEXPRESS_FORWARDING=false
ALIEXPRESS_PROTOCOL=iop
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=

# Production setup: npm run setup:production -- --domain ...
STORE_DOMAIN=
SMTP_REQUIRE_TLS=true
SEED_DEMO_PRODUCTS=false

# Refresh known supplier shipments every 5 minutes, stock every 6 hours.
# Does not place orders, pay suppliers or request cancellations automatically.
SUPPLIER_AUTO_SYNC=false
